
config xbslink 'config'
        # --- service -----------------------------------------------------------
        option enabled '0'
        # LAN side to capture on. This is the KERNEL device name of the LAN
        # bridge, normally 'br-lan' on OpenWrt 21.02+ (check: ip link show).
        # xbslinkd automatically attaches one sniffer per bridge port so that
        # unicast frames between ports are seen as well.
        option interface 'br-lan'
        # Name shown to other XBSlink nodes
        option nickname 'OpenWrt'
        # Node-to-node UDP port (must match the original clients, default 31415)
        option port '31415'
        # Static remote nodes to announce to at startup, e.g.:
        #   list peers '1.2.3.4:31415'
        #   list peers 'example.ddns.net:31415'

        # --- capture tuning ----------------------------------------------------
        # Forward ALL udp broadcasts with destination port >= 1024 (PS3/PS4,
        # some games). Increases traffic; off by default.
        option forward_high_port_broadcasts '0'
        # Do not exclude TCP/UDP ports below 1024 from tunneling (rarely needed)
        option allow_wellknown_ports '0'
        # Extra source MACs whose frames should always be tunneled
        # (comma separated, e.g. 'aa:bb:cc:dd:ee:ff,11:22:33:44:55:66')
        option special_macs ''
        # Gateway IPs to exclude from tunneling (auto-detected when empty)
        option gateway_ips ''

        # --- cloud (node discovery) --------------------------------------------
        option cloud_enabled '0'
        # Official server is offline; point this at your own cloudlist/index.php
        # instance for node discovery (see docs/BUILD.md).
        option cloud_server 'http://www.secudb.de/~seuffert/xbslink/cloudlist/'
        option cloud_name ''
        # Password is only checked when CREATING a new cloud
        option cloud_password ''
        option cloud_max_nodes '10'
        # IP to register at the cloud. Leave empty for automatic detection;
        # private IPs are substituted by the server with your public IP.
        option node_ip ''

        # --- status --------------------------------------------------------------
        # JSON status file for the LuCI app (read through rpcd file API)
        option status_file '/var/run/xbslinkd/status.json'
        # Local-only HTTP endpoint: http://127.0.0.1:<port>/status (0 = off)
        option status_port '31416'

        # --- misc -----------------------------------------------------------------
        option verbose '0'
